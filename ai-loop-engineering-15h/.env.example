# AI loop engineering (15-hour course): every setting the lessons read. Placeholders only; copy to .env and fill in.

# Gemini API key (default model for every loop lesson). Get one at https://aistudio.google.com/apikey
GOOGLE_CLOUD_API_KEY=your-gemini-api-key-here

# Alternative to the API key: a Vertex AI project (needs `gcloud auth application-default login`).
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Anthropic API key: optional. Only for a Claude model run (llm_setup) and the Agent SDK walkthroughs in lessons 10 and 16.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model ids the course uses. Verify each id against the provider's model list before a rebuild.
# TUT_LLM_MODEL=gemini-3.1-flash-lite

# Ollama server (optional free local model). Default is the server on this machine.
OLLAMA_BASE_URL=http://localhost:11434


# Lesson 28b: the lab Postgres container that holds the queue, the leases and the ledger. Lab-only values: the container is local and throwaway.
# lab-only database user for the local Postgres container (28b)
POSTGRES_USER=fleet_lab
# lab-only password for the local Postgres container (28b)
POSTGRES_PASSWORD=fleet-lab-password
# lab-only database name for the local Postgres container (28b)
POSTGRES_DB=fleet
# lab setting for the worker fleet (28b): seconds a lease lasts without a heartbeat (about 4 heartbeats)
LEASE_TTL_S=2.0
# lab setting for the worker fleet (28b): seconds between heartbeats
HEARTBEAT_S=0.5
# lab setting for the worker fleet (28b): provider requests allowed per window, for the whole project
LLM_LIMIT=3
# lab setting for the worker fleet (28b): the length of the provider window in seconds
LLM_WINDOW_S=10
# lab setting for the worker fleet (28b): seconds the desk spends on one finding
WORK_S=3.0
