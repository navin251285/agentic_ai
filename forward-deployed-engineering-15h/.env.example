# Google Cloud API key for Gemini on Vertex AI. Needed to record the LLM lessons once; replay needs no key.
GOOGLE_CLOUD_API_KEY=your-key-here
# Alternative to the API key: your Google Cloud project id and location (lessons 06, 11, 12, 18, 19, 20, 28, 31, 32).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# Path to a service-account JSON file, if you use one instead of an API key (leave empty otherwise).
GOOGLE_APPLICATION_CREDENTIALS=
# Model id the LLM lessons use (lessons 06 onward). Keep it on the cheapest current model.
TUT_LLM_MODEL=your-model-id
# Token for the mock customer API the lessons call (lesson 04). A local value for the lab only.
MOCK_ERP_TOKEN=lab-token-not-a-secret

# Lesson 13 (app step 3): the token callers send to the triage app's /api routes as 'Authorization: Bearer <token>'. Make one: python -c "import secrets; print(secrets.token_urlsafe(32))". Empty means the app answers 503 on /api.
TRIAGE_SERVICE_TOKEN=

# Lab-only signing key for the mock customer's access tokens (lesson 13). Not a real secret: a real customer keeps its signing keys in its identity provider.
ERP_SIGNING_KEY=lab-signing-key-not-a-secret-0123456789abcdef
# Lab-only client secret of the service account bb-orders-reader (lesson 13). A real secret lives in the customer's secret manager.
ERP_READER_CLIENT_SECRET=lab-reader-secret-not-real
# Lab-only client secret of the service account bb-credit-bot (lesson 13). A real secret lives in the customer's secret manager.
ERP_CREDIT_BOT_CLIENT_SECRET=lab-credit-secret-not-real

# Lesson 14: the service account the triage service uses to read orders (a name, not a secret). Compose falls back to bb-orders-reader.
ERP_READER_CLIENT_ID=bb-orders-reader
# lab default for the customer API address inside the Compose network (lesson 14); the default fits the lab
ERP_URL=http://erp:8000

# Lesson 15: the model API stand-in the triage service calls (a lab host name, not a real model). Lesson 15 only.
MODEL_API_URL=http://api.model-vendor.example:8000
# Lesson 15: the egress proxy the triage service uses for outside calls. Lab default: the proxy in the Compose file. A customer sets its own proxy here.
EGRESS_PROXY_URL=http://egress:3128

# Lesson 16: the OpenTelemetry Collector the triage service sends its traces to (inside the Compose network; a customer sets its own collector here).
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Lesson 16: how many milliseconds the lab customer API waits on every third /orders call (a flaky customer system; lab only).
ERP_SLOW_MS=1500

# Lesson 27: the region where the customer's stored records are kept (a lab default; the contract sets the real one).
STORAGE_REGION=us-east1
# Lesson 27: the region where the model endpoint processes prompts (a lab default; the deployed setting).
MODEL_REGION=us-east1
# Lesson 27: the regions the customer's contract allows for its data, comma-separated (a lab default).
ALLOWED_REGIONS=us-east1,us-central1
# Lesson 27: how many days triage records are kept (the deployed retention setting).
RETENTION_DAYS=30
# Lesson 27: the longest retention the customer's contract allows, in days.
CONTRACT_MAX_RETENTION_DAYS=90
# Lesson 27: the service account name written into each audit line (a name, not a secret).
TRIAGE_ACTOR_ID=bb-triage

# Lesson 28: the provider's API host that the lab route passes model calls on to (the Vertex AI endpoint by default; a customer sets its own).
PROVIDER_API_BASE=https://aiplatform.googleapis.com
# Lesson 28: the address of the customer's route to the model as the notebook sees it (the lab route in Compose; a customer sets its own gateway).
PROVIDER_ROUTE_URL=http://localhost:8280

# Lesson 32: the storage region of the fresh customer (Corner Crate, invented). The drill's own config; the contract sets the real one.
DRILL_STORAGE_REGION=europe-west1
# Lesson 32: the region where the model endpoint processes the fresh customer's prompts (a lab default; the deployed setting).
DRILL_MODEL_REGION=europe-west1
# Lesson 32: the regions the fresh customer's contract allows, comma-separated (a lab default).
DRILL_ALLOWED_REGIONS=europe-west1,europe-west4
# Lesson 32: how many days the fresh customer's triage records are kept (the deployed setting).
DRILL_RETENTION_DAYS=14
# Lesson 32: the longest retention the fresh customer's contract allows, in days.
DRILL_CONTRACT_MAX_RETENTION_DAYS=30
# Lesson 32: the cost budget per labelled case for the fresh customer, in USD (a lab default).
DRILL_COST_PER_CASE_BUDGET=0.001
