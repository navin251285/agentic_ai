# Default model access: Gemini on Vertex AI. Needed only while building (recording) lessons;
# notebooks replay recorded calls with no key.
GOOGLE_CLOUD_API_KEY=
# Model ids (pinned in one place; see RESEARCH.md section 1)
TUT_LLM_MODEL=gemini-3.5-flash-lite
# TUT_LLM_MODEL_LARGE=gemini-3.8-flash   # "LARGE" = the bigger of two roles (lesson 17), not the large model
# Optional: record real Anthropic / OpenAI calls in lessons 09, 21, 36 (otherwise payloads are shown by hand)
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
# Optional local model (lesson 14): Ollama on http://localhost:11434
# TUT_LLM_LOCAL=granite4.1:3b
