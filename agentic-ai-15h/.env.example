# Agentic AI (15-hour course): every setting the lessons read. Placeholders only; copy to .env and fill in.

# Gemini API key (default model for most lessons). Get one at https://aistudio.google.com/apikey
GOOGLE_CLOUD_API_KEY=your-gemini-api-key-here

# Alternative to the API key: a Vertex AI project (needs `gcloud auth application-default login`).
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Anthropic API key: only for lesson 05 when you want a live run instead of the recording.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API key: optional. No lesson calls OpenAI live (lesson 05 shows the OpenAI format without a call).
OPENAI_API_KEY=your-openai-api-key-here

# Model ids the course uses. Verify each id against the provider's model list before a rebuild.
# TUT_LLM_MODEL=gemini-3.1-flash-lite

# Ollama server for lesson 03 (a free local model). Default is the server on this machine; change it only if Ollama runs elsewhere.
OLLAMA_BASE_URL=http://localhost:11434

# lab-only: client secret of the support-chat client in the local token issuer (lesson 26). Not a real credential; the issuer listens on 127.0.0.1 only.
LESSON26_SUPPORT_CHAT_SECRET=lab-support-chat-secret
# lab-only: client secret of the refund-console client in the local token issuer (lesson 26). Not a real credential; the issuer listens on 127.0.0.1 only.
LESSON26_REFUND_CONSOLE_SECRET=lab-refund-console-secret

# lab-only (lesson 34): the Redis URL the fleet's replicas share. Leave it empty: one local process then keeps its state in memory,
# and the Docker fleet sets its own value in infra/serving/compose.yml.
REDIS_URL=
# lab-only (lesson 34): the release a replica runs, v1 or v2. Empty means v1. The fleet sets it for each container.
AGENT_VERSION=
# lab-only (lesson 34): the golden set's orders file for a replica. Empty means the container default, /data/support_eval.json.
ORDERS_FILE=
# lab-only (lesson 34): a name for the replica that answers the request. Empty means the container's own hostname.
REPLICA_NAME=

# lab-only (lesson 35): the address of the Temporal server the refund workers connect to. Empty means localhost:8350, the
# port the Compose dev server publishes (infra/durable/compose.yml). Not a secret.
TEMPORAL_ADDRESS=
# lab-only (lesson 35): the ledger file the mock payment provider writes, shared by the workers. The notebook sets it. Leave empty.
PAYMENTS_DB=
# lab-only (lesson 35): the seconds a mock payment reply is delayed after the money moves. The drill sets it. Leave empty (0).
PAY_REPLY_DELAY_S=
# lab-only (lesson 35): the receipts file the refund workers append to. The notebook sets it. Leave empty.
RECEIPTS_FILE=

# app only (app/, step 1): the cost caps of one chat turn, and the order world the tools read. Defaults are the values here.
SUPPORT_MAX_STEPS=4
SUPPORT_MAX_USD=0.01
# SUPPORT_ORDERS_FILE=data/support_eval.json
# SUPPORT_PORT=8980
# app only (app/, step 2): the policy passages the desk searches, and the folder of its saved memory, refunds and runs.
# SUPPORT_POLICY_FILE=data/ftc_chunks_embeddings.json
# SUPPORT_STATE_DIR=/an/absolute/path/to/app/state   (empty: app/state beside the app)
