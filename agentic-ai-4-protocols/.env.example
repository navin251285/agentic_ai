# Copy to .env and fill in the keys you have. Any one provider is enough.
# Every lesson prints all providers and models, whether each key is set, and which models
# that lesson has a recording for. A model with a recording runs with no key.
GOOGLE_CLOUD_API_KEY=your-key-here
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Local models need no key: install Ollama and run `ollama serve` (OLLAMA_HOST to change the address).

# Which model the agents use: gemini, anthropic, openai or ollama (model ids: python llm_setup.py)
TUT_LLM_PROVIDER=gemini
TUT_LLM_MODEL=gemini-3.1-flash-lite

# Lesson 31b: the one web origin allowed to call the AG-UI endpoint (browser origin, scheme://host:port).
AGUI_ALLOWED_ORIGIN=http://localhost:5173
# Lesson 31b: signs the dev tokens of the notebook's stub authorization server. Leave empty for a random per-run key; if set, use 32+ characters.
AGUI_DEV_SIGNING_KEY=

# Lesson 29a: a lab-only fake token that the sandboxing demo's malicious server tries to steal. Not a real credential.
DEMO_SERVICE_TOKEN=replace-with-a-random-secret

# Lesson 34: admin user of the local Keycloak container (lab only; the realm file holds no passwords).
KEYCLOAK_ADMIN=admin
# Lesson 34: password of the Keycloak admin in the local lab container (lab-only password for the local Keycloak container).
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-random-secret
# Lesson 34: password of the demo user alice in the ops-desk realm (lab-only password for the local Keycloak container).
TRACKR_DEMO_PASSWORD=replace-with-a-random-secret

# Lesson 32: public URL of the Trackr proxy, written into the agent card (lab value: the nginx port of the compose stack).
TRACKR_PUBLIC_URL=http://localhost:8320
# Lesson 32: database URL the Trackr replicas share for tasks (lab value: a SQLite file in data/32; use PostgreSQL in production).
TRACKR_DB_URL=sqlite+aiosqlite:///tasks.db
# Lesson 32: settings the notebook sets for each replica it starts (lab values, not secrets): the replica name, the model switch (on/off),
# the step delay in seconds, and the hosts the replica accepts. The Docker stack reads the same names from docker-compose.yml.
TRACKR_REPLICA=a
TRACKR_MODEL=off
TRACKR_STEP_DELAY_S=1.0
TRACKR_ALLOWED_HOSTS=localhost,127.0.0.1
TRACKR_ISSUES=../data/trackr_05b_issues.json
# Lesson 32: writer switch. Set to 1 to save the Docker run's real outputs to data/recorded/32.json for the fallback.
TUT_SAVE_RECORDED=0

# Lesson 35: client secret of the nightly triage agent at the stand-in authorization server (lab-only value for the local lab server; a real one lives in your identity provider's secret store).
TRIAGE_CLIENT_SECRET=replace-with-a-random-secret
# Lesson 35: client secret of Trackr, the client that exchanges tokens at the stand-in authorization server (lab-only value for the local lab server).
TRACKR_CLIENT_SECRET=replace-with-a-random-secret
# Lesson 37: the issuer name that signs the orchestrator's tokens (the realm of lesson 34 in the lab; the lab issuer in the notebook uses this value as iss).
TRIAGE_ISSUER=http://127.0.0.1:8340/realms/ops-desk
# Lesson 37: the token endpoint that the triage-agent card names in its OAuth 2.0 client credentials scheme (lab value: lesson 34's realm).
TRIAGE_TOKEN_URL=http://127.0.0.1:8340/realms/ops-desk/protocol/openid-connect/token
# Lesson 37: key id (kid) of the key that signs the triage-agent Agent Card. Verifiers pin the public key under this id.
TRIAGE_CARD_KID=triage-card-1

# Lesson 38: master key from which each tenant's key for the A2A results store is derived (lab-only; empty = a random key per run). Use a key from your key service in production.
TASK_STORE_MASTER_KEY=
# Lesson 38a: client secret of the ops orchestrator at the stand-in authorization server (lab-only value for the local lab server; a real one lives in your identity provider's secret store).
ORCHESTRATOR_CLIENT_SECRET=replace-with-a-random-secret
# Lesson 38a: client secret of the triage agent at the stand-in authorization server (lab-only value for the local lab server; the triage agent exchanges tokens with it).
TRIAGE_AGENT_CLIENT_SECRET=replace-with-a-random-secret

# Lesson 39: lab password of alice, bob and carol in the ops-org realm (lab-only password for the local Keycloak container and the stand-in; the realm file holds no passwords).
ORG_DEMO_PASSWORD=replace-with-a-random-secret
# Lesson 39: client secret of the ops-agent client at the organisation's server (lab-only value for the local lab server; a real one lives in your identity provider's secret store).
ORG_OPS_AGENT_SECRET=replace-with-a-random-secret
# Lesson 39: client secret of the triage-agent client at the organisation's server (lab-only value for the local lab server).
ORG_TRIAGE_AGENT_SECRET=replace-with-a-random-secret
