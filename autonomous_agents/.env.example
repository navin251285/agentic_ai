# Copy to .env and fill in. The real .env is never committed.

# Simulation
SIM_SEED=
DATA_DIR=./data
DEFAULT_SCENARIO=normal_day
AGENT_INTERVAL_S=5
SAVE_INTERVAL_S=3
API_PORT=8000
VITE_API_TARGET=http://localhost:8000

# Docker on Linux only: run the api as you (id -u / id -g) so files in api/data stay editable
HOST_UID=
HOST_GID=

# Agent
AGENT_MODE=rules
GOOGLE_CLOUD_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite
LLM_TIMEOUT_S=8
# May be lowered, never raised: at most 10 calls/min, at least 6s apart.
LLM_MAX_CALLS_PER_MIN=10
LLM_MIN_GAP_S=6
